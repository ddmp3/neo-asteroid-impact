# GeoNames API Configuration
# Register at: https://www.geonames.org/login
# Enable "Free Web Services" in your account settings
# IMPORTANT: Never commit your real username - use .env file (gitignored)
GEONAMES_USERNAME=your_geonames_username_here

# USGS APIs (no key required)
USGS_ELEVATION_API=https://epqs.nationalmap.gov/v1
USGS_EARTHQUAKE_API=https://earthquake.usgs.gov/fdsnws/event/1

# NASA APIs (optional)
NASA_API_KEY=DEMO_KEY

# Application Insights (Azure monitoring - optional)
APPINSIGHTS_INSTRUMENTATIONKEY=

# Environment
NODE_ENV=development
PORT=7071
